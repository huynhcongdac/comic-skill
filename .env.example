# Copy to .env and fill in. Never commit .env.

# ── Images ─────────────────────────────────────────────────────────
# sangtao.ai (default): about 100–400 VND per image depending on the plan, up to 20 reference images per image.
# API calls need a plan or credit. Pricing: https://sangtao.ai/vi/imagine?tab=pricing
# Get a key: https://sangtao.ai  ·  Docs: https://sangtao.ai/vi/api-docs/chatgpt-image
IMAGE_PROVIDER=sangtao
SANGTAO_API_KEY=
SANGTAO_RESOLUTION=2K

# or OpenAI Images
# IMAGE_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
